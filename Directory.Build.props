<?xml version="1.0" encoding="utf-8"?>
<!-- Auto-generated by Polyphase editor on project open.
     Sets PolyphasePath for any .vcxproj under this folder so
     native addons in Packages/ build without per-machine setup.
     Safe to commit: the path is only applied when it exists on
     the current machine, so teammates with a different engine
     location fall through to their own env-var/install probes.
     The editor rewrites this file each time the project is
     opened. -->
<Project>
  <PropertyGroup>
    <PolyphasePath Condition="'$(PolyphasePath)' == '' and Exists('\opt\polyphase\Polyphase.sln')">\opt\polyphase</PolyphasePath>
    <PolyphasePath Condition="'$(PolyphasePath)' == '' and Exists('\opt\polyphase\Polyphase.exe')">\opt\polyphase</PolyphasePath>
  </PropertyGroup>
</Project>
